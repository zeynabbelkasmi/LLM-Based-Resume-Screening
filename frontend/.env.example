# Préfixe public du backend. /api utilise le proxy Vite en développement.
VITE_API_URL=/api

# L'interface repasse automatiquement sur les données de démonstration si l'API est indisponible.
VITE_ENABLE_MOCKS=false

# Cible du proxy local Vite (variable serveur, non exposée dans le bundle).
API_PROXY_TARGET=http://localhost:8000

# Ne jamais placer une clé de fournisseur LLM dans une variable VITE_*.
# La clé doit rester côté serveur dans OVH_AI_ENDPOINTS_ACCESS_TOKEN.
