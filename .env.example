# Qwen3 8B servi localement par LM Studio (API OpenAI-compatible)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Remplacez cette valeur par l'identifiant exact retourné par GET /v1/models.
LM_STUDIO_MODEL=qwen/qwen3-8b
# Facultatif : uniquement si « Require Authentication » est activé dans LM Studio.
LM_STUDIO_API_TOKEN=

CVANALYSE_LLM_TIMEOUT=180
CVANALYSE_LLM_MAX_ATTEMPTS=3
CVANALYSE_LLM_BACKOFF_BASE=0.35
CVANALYSE_LLM_BACKOFF_MAX=4

# Backend local
CVANALYSE_DB_PATH=analyses.db
CVANALYSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CVANALYSE_MAX_UPLOAD_MB=15
CVANALYSE_MAX_PDF_PAGES=40
